sequenceDiagram
    autonumber
    actor Customer
    participant SYS as BiblioHubSystem
    participant User
    participant BS as BookStock
    participant BI as BookInfo
    participant BK as Book

    Note over Customer: get all book in system
    Customer ->>+ SYS: get_all_book_series() 
    SYS -->>- Customer: return book series list [list]

    Note over Customer: search bookinfo by series
    Customer ->>+ SYS: search_book_by_series(book_series)
    loop bookstock in bookstock_list
        SYS ->>+ BS: get_book_series()
        BS -->>- SYS: return book_series [string]

        opt series matches
            SYS ->>+ BS: get_book_list()
            BS -->>- SYS: return book_forsale_list, book_rent_list [list]
        end


    end

    SYS -->>- Customer: return book_forsale_list, book_rent_list [list]

    loop Select Book
        Customer ->>+ SYS: select_book(phonenumber,book_id,start_date,num_days)
        
        SYS ->> SYS: get_user_from_phone_number(phonenumber)
        NOTE over SYS: get_user_from_phone_number method
        SYS ->> SYS: validate_phonenumber(phonenumber)

        opt Invalid Phone Number Format
            SYS -->> Customer: return error message "Invalid phone number format"
        end

        alt Invalid Phone Number
            SYS -->> Customer: return error message "Invalid phone number"
        else Valid Phone Number
            loop customer in customer_list
                SYS ->>+ User: get_phone_number():
                User -->>- SYS: return phone_number

                alt phone_number found
                    NOTE right of SYS: return customer object
                else phone_number not found
                    NOTE right of SYS: return error message "Phone number not found"
                end
            end
            NOTE over SYS: end of get_user_from_phone_number method
        end

        SYS ->> SYS: check_type_from_id(item_id)

        NOTE over SYS: check_type_from_id method
        alt Invalid ID Format
            SYS -->> Customer: return error message "Invalid ID format"
        else Valid ID Format
            alt ID starts with "BK"
                NOTE left of SYS: return "Book"
            else ID starts with "AR"
                NOTE left of SYS: return "Area"
            else Invalid ID Prefix
                SYS -->> Customer: return error message "Invalid ID format"
            end
        end

        NOTE over SYS: end of check_type_from_id method

        SYS ->> SYS: get_data_from_id(item_id)
        NOTE over SYS: get_data_from_id method

        alt Type of Item is "Book"
            NOTE left of SYS: return activity_type, series, book_name
        else Type of Item is "Area"
            NOTE left of SYS: return area information (if applicable)
        else Invalid Type of Item
            SYS -->> Customer: return error message "Invalid ID format"
        end

        NOTE over SYS: end of get_data_from_id method

        alt Activity Type is Rent
            SYS ->>+ User: check_quota()
            User -->>- SYS: return quota status [bool]

            alt Quota Not Available
                SYS -->> Customer: return error message "Quota not available"
            end
        end

        SYS ->> SYS: get_book(series,book_name,activity_type)
        NOTE over SYS: get_book method
        
        loop bookstock in bookstock_list
            SYS ->>+ BS: get_book_series()
            BS -->>- SYS: return book_series [string]
            
            alt series matches
                SYS ->>+ BS: get_book_available(book_name,activity_type)
                BS ->>+ BI: get_book_available()
                BI -->>- BS: return book_info [object]
                BS -->>- SYS: return book [object]

                alt book found
                    NOTE right of SYS: return book object
                else book not found
                    NOTE right of SYS: return error message "Book not found"
                end
            else series does not match
                NOTE right of SYS: continue searching in next bookstock
            end
        end

        NOTE over SYS: end of get_book method

        SYS ->>+ BS: search_book_available(bookname,activity_type)
        BS ->>+ BI: search_book_available()
        BI -->>- BS: return book_info [object]
        BS -->>- SYS: return book [object]
        SYS ->>+ User: select(book)
        User -->>- SYS: return select successful
        SYS -->> Customer: return select successful
    end

    


