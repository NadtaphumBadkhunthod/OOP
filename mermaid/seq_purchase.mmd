sequenceDiagram
    autonumber
    actor CS as Customer
    actor MB as Member
    participant SYS as System
    participant BS as BookStock
    participant BN as BookName
    participant BK as Book

    loop Select Book
        CS ->> SYS : search_book(book_series, bookname, activity_type="Purchase")
        SYS ->> CS : check_eligibility()
        CS -->> SYS : return eligibility_status [bool]

        alt eligible
            SYS ->> BS : search_book_available(bookname, "Purchase")
            BS ->> BN : search_book_available()
            BN ->> BK : check_availability()
            BK -->> BN : return available [bool]
            BN -->> BS : return book_object
            BS -->> SYS : return book_object
            SYS ->> CS : add_search_result(book_object)
            SYS -->> CS : return search_results [dict]

            alt Book available
                SYS -->> CS : return book_object

                opt Want that book
                    CS ->> CS : select(book)
                    CS ->> BK : change_status(Status.Selected)
                end

                opt Already selected and don't want it
                    CS ->> CS : unselect(book)
                    CS ->> BK : change_status(Status.Available)
                end

            else Not available
                SYS -->> CS : No Book Available
            end

        else Not eligible (strike >= 3)
            SYS -->> CS : You can't buy or rent
        end
    end

    CS ->> SYS : checkout(customer, staff, selected_list, payment_method)

    loop All items in selected_list
        SYS ->> BK : get_activity_type()
        BK -->> SYS : return "Purchase"

        opt is Purchase
            create participant PC as Purchase
            SYS ->> PC : Purchase([book])
        end
    end

    create participant PS as Payment
    SYS ->> PS : Payment(customer, order_list, payment_method)
    PS -->> SYS : return payment [object]

    SYS ->> PS : calculate_net_amount()
    PS -->> SYS : return net_amount [float]

    alt payment_method == "QRCode"
        create participant QR as QRCode
        SYS ->> QR : QRCode(gateway_reference)
        SYS ->> QR : process_payment(net_amount)
        QR -->> SYS : return True
    else payment_method == "Cash"
        create participant CA as Cash
        SYS ->> CA : Cash()
        SYS ->> CA : process_payment(net_amount)
        CA -->> SYS : return True
    end

    SYS ->> PS : update_payment_status("Paid")

    create participant TS as Transaction
    SYS ->> TS : Transaction(customer, staff, datetime.now(), payment)
    TS -->> SYS : return transaction [object]

    SYS ->> TS : add_audit_log(f"request: {datetime.now()}")
    SYS ->> TS : update_status("Confirm")

    loop All Purchase items
        loop Each book in purchase_items
            SYS ->> BK : change_status(Status.Purchased)
            BK -->> SYS : change_status successful
        end
    end

    SYS ->> CS : add_transaction(transaction)
    CS -->> SYS : return add_transaction successful

    SYS ->> SYS : notify_user(customer, "{name}: transaction ... confirm")
    create participant NT as Notification
    SYS ->> NT : Notification(customer, "{name}: transaction ... confirm")
    NT -->> SYS : return notification [object]
    SYS ->> CS : add_notify(notification)
    CS -->> SYS : return add_notify successful

    opt is Member
        SYS ->> MB : add_point()

        SYS ->> SYS : notify_user(customer, "{name}: add point successful")
        SYS ->> NT : Notification(customer, "{name}: add point successful")
        NT -->> SYS : return notification [object]
        SYS ->> CS : add_notify(notification)
        CS -->> SYS : return add_notify successful
    end

    SYS -->> CS : return "ทำรายการเสร็จสิ้น"
