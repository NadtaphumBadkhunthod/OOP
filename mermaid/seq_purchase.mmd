sequenceDiagram
    autonumber
    actor US as User
    participant SYS as System
    participant CS as Customer
    participant BS as BookStock
    participant BI as BookInfo

    Note over US, SYS: --- SELECT BOOK PHASE ---
    loop Select Book
        US ->> SYS: select_book(phone, book_name, activity_type = "Purchase")
        activate SYS
        SYS ->> SYS: get_customer_by_phone(phone)
        SYS ->> SYS: get_bookinfo(series, name, activity_type)

        SYS ->> BS: search_bookinfo(name, activity_type = "Purchase")
        activate BS
        BS ->> BI: get_bookinfo()
        activate BI
        BI -->> BS: return bookinfo
        deactivate BI
        BS -->> SYS: return bookinfo
        deactivate BS

        SYS ->> CS: select(book)
        activate CS
        create participant BO as BookOrder
        CS ->> BO: BookOrder(BookInfo)
        activate BO
        BO -->> CS: return book_order
        deactivate BO
        CS -->> SYS: return selected_list[]
        deactivate CS
        SYS -->> US: return selected_list[]
        deactivate SYS
    end
