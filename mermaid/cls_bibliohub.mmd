---
config:
  layout: elk
  theme: redux_dark
---
classDiagram
direction TB
	class Staff {
	    -no_staff
	    -no_branch "อยู่สาขาไหนจ๊ะ"
	    +process_return(book,customer)
    }

    class ActivityType {
        <<enumeration>>
        Rent
        Purchase
    }
    class TypeBook {
        <<enumeration>>
        Manga
        Novel
        Historical
        Education
        Self_improvement
        Economic
    }
    class BookStatus {
        <<enumeration>>
        Available
        UnAvailable
        Selected
        Purchased
        Incoming
    }
    class PaymentStatus {
        <<enumeration>>
        Unpaid
        Paid
        Voied
    }
    class TransactionStatus {
        <<enumeration>>
        Requested
        Confirm
        In_Use
        Completed
        Cancelled
    }
    class BookingBookQuota {
        <<enumeration>>
        Silver
        Gold
        Platinum
    }
    class LevelMember {
        <<enumeration>>
        Silver
        Gold
        Platinum
    }
    class BirthMonth {
        <<enumeration>>
        Jan - Dec
    }

    class Book {
        -BookInfo book_info
        -String book_uid
        -Int borrowed_count
        -BookStatus book_status "Selected, Available, Incoming, Not Available"
        -Date start_date
        -Date end_date
        -Date actual_return_date
        +calculate_end_date(how_many_days: int)
        +check_availability()
        +change_status()
		+get_rate_info()
        +change_activity_type(activity_type: ActivityType)
		+get_activity_type()
    }

    class BookInfo {
        -String __name
        -BookStock __book_stock
        -String __author
        -TypeBook __category
        -Float __price
        -ActivityType __activity_type
        -List~Book~ __book
        -Date __available_date
        -String __id
        +add_copies(copies: int)
        +search_book_available()
    }

    class BookStock {
        -String name
        -List forsale_book_list[]
	    -List rent_book_list[]
        +get_book_list(activity_type: ActivityType)
        +add_book_info(book_info: BookInfo, activity_type: ActivityType)
        +remove_book(book)
        +search_book_avaliable() "ใส่มาจ้วยว่าจะ search อะยัย"
    }

	class TimeSlot {
	    -Area area "เก็บว่ามาจากไหน"
	    -DateTime start_time
	    -DateTime end_time
	    -Bool is_available
	    +update_slot()
    }

    class Area {
        -String area_id
        -String area_type
	    -Float hourly_rate "ค่าบริการรายชั่วโมง"
	    -List feature[]
        -Int capacity
	    -List slots[] "มีสล๊อตไหนบ้าง"
        +list_timeslot()
        +get_rate_info()
    }

	class QRCode {
	    -String gateway_reference
	    +process_payment()
    }

    class Cash {
	    +process_payment()
    }

	class Promotion {
	    -String promo_code
	    -Float discount_rate
	    -Bool is_active
	    -List Used_User
	    +is_eligible()
	    +apply_discount()
    }
    
    class DoubleDate {
	    -List day_pattern
	    +is_eligible() "อยู่ในวันเข้าร่วมโปรโมชั่นหริอไม่"
    }

    class BirthDate {
	    -Int birth_month
	    +is_eligible() "เป็นสมาชิก และ อยู้่ในเดือนเกิดหรือไม่"
    }

	class Transaction {
	    -Customer user "ผู้ทำรายการ"
	    -Staff staff "staff_obj"
	    -DateTime start_date_time "วันที่เริ่มรายการ"
	    -DateTime end_date_time "กำหนดการสิ้นสุด"
	    -String status "Requested, Confirmed, In Use, Completed, Cancelled"
	    -Payment payment "เอาทั้งobjectPaymentมาใส่เลย"
	    -List audit_logs_list[] "บันทึกการแก้ไขข้อมูลในรายการนี้"
	    +update_status()
	    +add_audit_log() "Log of Transaction"
	    +sync_payment_with_activity() "ดึงค่าปรับจาก RentBook มาใส่ Payment"
    }

    class BookingArea {
	    -List reserved_slots[]
	    +calculate_total_price()
	    +request_upgrade() "request กลับระบบไป search area"
	    +calculate_upgrade_delta()
	    +update_reserved_slots()
    }

	class BookingBook {
	    -List book_list[]
	    -DateTime reservation_date "วันที่จองหนังสือ"
	    -DateTime pickup_deadline"เวลาสุดท้ายที่ต้องมารับหนังสือ"
	    +check_pickup_deadline()
	    +calculate_total_books()
    }

	class RentBook {
	    -DateTime rental_date "วันที่เช่าตามกำหนด"
	    -DateTime due_date "วันที่ต้องคืนตามกำหนด"
	    -DateTime actual_return_date"วันที่คืนจริง"
	    -Float late_penalty_rate"อัตราค่าปรับต่อวันของหนังสือเล่มนั้น"
	    +calculate_late_penalty()
    }

    class Purchase {
	    -List purchase_items[]
	    +calculate_subtotal()
    }

    class Payment {
        -Customer customer "ผู้ทำรายการ"
        -String payment_no "เลขสลีปปื้ง"
        -String status"Unpaid, Paid, Voided"
        -List order "เก็บก้อน BookingCafe/BookingBook/RentBook/Purchase"
        -DateTime timestamp
        -PaymentMethod payment_method
        -base_fee"ค่าบริการหลัก"
	    -upgrade_delta"ยอดส่วนต่างจากการอัปเกรด"
	    -discount_amount"ยอดส่วนลด"
	    -penalty_fee"ค่าปรับทั้งหมด"
	    -net_amount"ยอดสุทธิที่ต้องจ่าย"
        +calculate_net_amount()
        +update_payment_status(status: PaymentStatus)
        +add_penalty_fee(penalty_fee)
    }

	class PaymentMethod {
        <<abstract>>
        +name*
        +process_payment(Amount)*
	}

	class Manager {
        +print_report()
    }

    class Notification {
	    -String message
	    -Customer target_user
	    -String notification_id
	    +send_message() "send_expiry_alert(transaction, lead_time) "
    }

	class Customer {
        -String name
        -String surname
        -String phonenumber
        -String email
        -List transaction[]
        -List notification_list[]
        -DateTime booking_reservation_time "แต่ละระดับจะมีค่าไม่เท่ากัน"
	    -Int rental_quota "แต่ละระดับจะมีค่าไม่เท่ากัน"
	    -Int strike "จำนวนการเตือน"
	    -List select[] "เลือกอะไรจากร้านบ้าง"
	    +check_eligibility() "เช็คสิทธิ์ในการทำรายการ : มีหนี้ หรือ ประวัติไม่ดี"
        +check_quota()
        +select() "ไปเอา return มาจากระบบตอน search"
		+unselect()
        +add_notify(notification)
        +add_transaction(transaction)
    }

	class Member {
	    -String level_member
	    -Int birth_month
	    -Int points
	    -Int booking_book_quota "ต่างกันในแต่ละรดับ"
	    -DateTime expiration_date
        +add_point()
    }

	class BiblioHubSystem {
	    -List staff_list[]
	    -List promotion_list[]
	    -List book_stock[]
	    -List area[]
	    -List customer_list[]
	    -List transaction_list[]
	    -List notification_list[]
        +register()
	    +delete_member()
	    +check_duplicate_account()
	    +validate_input_data()
	    +get_user_from_phone_number()
	    +search_book()
	    +search_area()
	    +checkout()
	    +verify_permission()
        +add_book_stock()
        +add_staff()
        +add_promotion()
        +add_area()
        +remove_area()
        +add_strike()
        +reduce_strike()
        +notify_user()
	    +upgrade_booking_area() "อัพเกรดarea"
        +generate_utilization_report()
    }

    BiblioHubSystem "0..*" <-- "1" BookingArea
    BiblioHubSystem "1" o-- "1..*" Staff
    BiblioHubSystem "1" o-- "1..*" Area
    BiblioHubSystem "1" o-- "0..*" Customer
    BiblioHubSystem "1" o-- "0..*" Transaction
    BiblioHubSystem "1" o-- "0..*" BirthDate
    BiblioHubSystem "1" o-- "0..*" DoubleDate
    BiblioHubSystem "1" o-- "1..*" BookStock
    BiblioHubSystem "1" o-- "0..*" Notification

    Customer <|-- Member
    Member <|-- Staff
    Staff <|-- Manager
    
    Purchase <|-- RentBook
    Purchase <|-- BookingBook
    Purchase <|-- BookingArea

    Transaction "1" --> "1" Staff
    Payment "1" <-- "1" Transaction
    BookingArea "1" o-- "1..*" TimeSlot
    
    Order "1" *-- "1" Purchase
    Order "1" *-- "1" RentBook
    Order "1" *-- "0..1" BookingBook
    Order "1" *-- "0..1" BookingArea
    
    Payment "1" *-- "1" Order
	Payment "1" o-- "1" PaymentMethod
    BookInfo "1" *-- "0..*" Book
    BookStock "1" o-- "0..*" BookInfo

	BirthDate "1" --|> Promotion
	DoubleDate "1" --|> Promotion
    
    PaymentMethod <|-- Cash
    PaymentMethod <|-- QRCode