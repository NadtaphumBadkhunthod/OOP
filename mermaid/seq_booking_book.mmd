sequenceDiagram
    autonumber
    actor Member as Member
    participant System as BiblioHubSystem
    participant Customers as Customer   
    participant Bookstock as Bookstock 
    participant Bookinfo as Bookinfo 
    participant Book as Book
    
    Member->>System: select_book(phonenumber,book_id,reservation_date,pickup_deadline)
    activate Member
    System->>System: get_user_from_phone_number(phonenumber)
    loop ลูปเอาค่าของ activity_type series book_name ออกมาจากbook_id
        System->>System: get_book(series,book_name,activity_type)
        Member->>Customers:Select(book)
        activate Member
        Customers-->>Member:return success
        deactivate Member
    end
    System->>Bookinfo: get_nums_incoming()
    activate System
    Bookinfo-->>System: return count
    deactivate System
    System->>Customers: check_booking_quota(phonenumber)
    activate System
    alt โควต้าผ่าน (Success Case)
        Customers-->>System: return quota[True]
        deactivate System
        System-->>Member: return {"status": "Success", "message": f"นำหนังสือใส่ตะกร้าแล้ว"}
        deactivate Member
    else สิทธิ์ไม่ผ่าน หรือ มีการจองซ้อน (Failure Case)
        System-->>Member: return {"error": f"โควต้าเต็ม!"}
    end

    Member->>System: checkout_booking_book(phonenumber,payment_method)
    activate Member
    loop เช็คว่ามี Book ใน attribute selected_list ในตัว customer
        alt มี Book ใน customer (Success Case)
            loop เช็ค type book ใน book
                alt type book เท่ากับ Booking (Success Case)
                    create participant BB as BookingBook
                    System->>BB:create_booking_book(book_id,reservation_date,pickup_deadline)
                    activate System
                    BB -->>System:return booking_book_obj
                    deactivate System
                    System->>System:checkout(customer, Staff(), [booking_order], payment_method)
                    System-->>Member:return ทำรายการสำเร็จ ชำระเงินรวมทั้งสิ้น net_amount บาท
                    deactivate Member
                else type book ไม่เท่ากับ Booking (Failure Case)
                    System-->>Member: return ไม่มีรายการจองหนังสือ
                end
            end
        else ไม่มี book ใน customer (Failure Case)
            System-->>Member: return ไม่มีรายการจองหนังสือ
        end
    end