sequenceDiagram
    autonumber
    actor Customer as Customer / Member
    participant System as BiblioHubSystem
    participant Trans as Transaction (In Use)
    participant NewArea as Area (New Type)
    participant Slot as TimeSlot
    participant Customers as Customer
    
    Note over Customer, Trans: ลูกค้านั่งใช้งานอยู่ในระบบแล้ว (Active Transaction)

    Customer->>System: upgrade_booking_area(new_area_id)
    activate Customer
    
    System->>System: search_area(new_area_id)
    activate System
    deactivate System
    
    %% ลูปค้นหาสล็อตว่าง
    loop ค้นหา Timeslot ใน Area
        System->>NewArea: list_timeslot(new_area_id)
        activate System
        loop TimeSlot ใน Area ว่าว่างหรือไม่
            NewArea->>Slot: check is_available
            activate NewArea
            Slot-->>NewArea: return status
            deactivate NewArea
        end
        NewArea-->>System: return available_slots
        deactivate System
    end

    System -->> Customer : return {"area_id": area_id, "available_slots": available_slots}

    Customer->>System: select_area(phonenumber, area_id, List[slot_ids])
    System->>System: get_user_from_phone_number(phonenumber)
    
    %% เช็คเวลาที่บวกเพิ่มว่าเกินโควต้าไหม
    System->>Customers: check_quota(phonenumber)
    activate System
    
    alt โควต้าผ่าน (Success Case)
        Customers-->>System: return quota[True]
        deactivate System
        
        %% ดึงข้อมูลที่นั่งเก่าออกมาเพื่อเตรียมเปรียบเทียบ
        System->>Trans: get_current_booking_area()
        activate Trans
        Trans-->>System: return old_booking_obj
        deactivate Trans
        
        create participant UArea as UpgradeArea
        System->>UArea: create(old_booking_obj, new_slots)
        activate UArea
        
        %% ตรวจสอบเงื่อนไขการอัปเกรด (ราคาต้องแพงกว่าเดิม)
        UArea->>UArea: validate_upgrade_rules()
        
        alt ราคาที่ใหม่ <= ราคาที่เดิม (Upgrade Failed)
            UArea-->>System: throw Error("Upgrade rate must be higher")
            System-->>Customer: return {"error": "ไม่สามารถอัปเกรดไปพื้นที่ราคาเท่าเดิมหรือถูกกว่าได้"}
        else ราคาที่ใหม่แพงกว่า (Upgrade Allowed)
            UArea->>UArea: calculate_delta()
            Note right of UArea: แยกคิดเงิน: <br/>1. ส่วนต่างสำหรับเวลาที่เหลือ<br/>2. ราคาเต็มสำหรับเวลาที่จองเพิ่ม
            UArea-->>System: return UArea_obj (พร้อมยอดส่วนต่าง)
            deactivate UArea
            
            %% จบที่การนำใส่ตะกร้า
            System->>Customers: add_to_selected_list(UArea_obj)
            activate Customers
            Customers-->>System: return add_success
            deactivate Customers
            
            System-->>Customer: show_upgrade_fee(UArea_obj.upgrade_delta)
            
            %% เรียกใช้ Checkout Flow 
            Customer->>System: checkout(phonenumber, staff, payment_method)
            
            Note over Customer,System: Execute Checkout Sequence Diagram
            
            %%สิ่งที่ต้องทำหลัง Checkout สำเร็จ 
            System->>UArea: apply_upgrade()
            activate UArea
            loop Release & Occupy
                UArea->>Slot: update_slot(old_slot, is_available=True)
                UArea->>Slot: update_slot(new_slot, is_available=False)
            end
            Slot-->>UArea: return success
            UArea-->>System: return apply success
            deactivate UArea
            
            System->>Trans: add_audit_log("Upgraded Area to " + new_type)
            System-->>Customer: return อัปเกรดเสร็จสมบูรณ์
        end
        
    else สิทธิ์ไม่ผ่าน หรือ มีการจองซ้อน (Failure Case)
        System-->>Customer: return {"error": f"โควต้าเต็ม! หรือไม่สามารถอัปเกรดได้"}
    end
    
    deactivate Customer